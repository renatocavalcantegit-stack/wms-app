# Configuração do servidor do WMS. Copie este arquivo para ".env" e preencha.
# O ".env" de verdade NÃO vai para o git (está no .gitignore), porque tem senha.

# Senha do usuário "postgres", definida na instalação do PostgreSQL
PGSENHA=coloque-a-senha-aqui

# Onde o banco está (o padrão serve para o PostgreSQL instalado neste computador)
PGHOST=localhost
PGPORTA=5432
PGUSUARIO=postgres

# Banco do sistema e banco usado só pelos testes (os testes apagam e recriam tudo nele)
PGBANCO=wms
PGBANCO_TESTE=wms_teste

# Porta em que o servidor do WMS atende
PORTA=3000
